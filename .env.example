# ============================================================
# Environment Variables — Business Web App
# Kopieren nach .env.local und Werte eintragen
# .env.local NIEMALS in Git committen
# ============================================================

# Datenbank
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/business_webapp?schema=public"

# NextAuth.js
# Generieren: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"

# Dokumente / Datei-Storage
# Option 1: Lokales Filesystem (nur Entwicklung)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/documents"

# Option 2: S3-kompatibel (Produktion)
# STORAGE_DRIVER="s3"
# AWS_ACCESS_KEY_ID="your-key"
# AWS_SECRET_ACCESS_KEY="your-secret"
# AWS_REGION="eu-central-1"
# AWS_BUCKET_NAME="business-webapp-documents"
# AWS_ENDPOINT="https://s3.eu-central-1.amazonaws.com"  # oder MinIO endpoint

# PDF-Erzeugung
PDF_FONT_PATH="./public/fonts"

# App-Konfiguration
NODE_ENV="development"
# Test-Löschmodus: nur lokal auf "1" setzen; bei Übergabe/Produktion immer "0"
TEST_DELETE_ENABLED="0"
NEXT_PUBLIC_APP_NAME="Business App"
NEXT_PUBLIC_APP_VERSION="1.0.0"
