# deploy/.env.production.example
# Vorlage — kopieren nach deploy/.env.production auf dem Server, echte Werte
# eintragen. NIEMALS mit echten Werten committen (siehe .gitignore-Ergänzung
# unten, falls deploy/.env.production noch nicht ausgeschlossen ist).

# ── Datenbank ────────────────────────────────────────────────
# Zeigt im Compose-Aufbau auf den internen "db"-Service, nicht öffentlich
# erreichbar. Passwort kommt separat über das Docker-Secret db_password.
DATABASE_URL="postgresql://business_webapp:<siehe secrets/db_password.txt>@db:5432/business_webapp?schema=public"

# ── NextAuth ─────────────────────────────────────────────────
# Neu generieren, NICHT aus einer lokalen .env.local übernehmen:
#   openssl rand -base64 32
NEXTAUTH_SECRET="<neu generieren>"
NEXTAUTH_URL="https://business.example.tld"

# ── Storage ──────────────────────────────────────────────────
# Muss auf den im Compose-File gemounteten Pfad zeigen (siehe
# docker-compose.production.yml, Volume "uploads").
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="/app/storage/documents"

# ── App ──────────────────────────────────────────────────────
NODE_ENV="production"
# Muss in Produktion IMMER "0" bzw. ungesetzt sein — zusätzlich bereits durch
# NODE_ENV-Gate in den betroffenen Server Actions abgesichert.
TEST_DELETE_ENABLED="0"
NEXT_PUBLIC_APP_NAME="Business App"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ── Hinweis: Dokumentenarchiv-Pfad ───────────────────────────
# company_settings.document_archive_path wird NICHT über eine Env-Variable,
# sondern über die Firmeneinstellungen-UI (Einstellungen → Dokumentenarchiv)
# in der Datenbank gepflegt. Vor dem ersten Produktionsstart dort auf einen
# Pfad UNTERHALB des "archive"-Volumes (z. B. /app/archive) umstellen oder
# die Archivierung dort deaktivieren — sonst schreibt die Anwendung in einen
# nicht gemounteten, nicht gesicherten Container-Pfad. Siehe Aufgabe-2-Matrix
# im Bericht.
